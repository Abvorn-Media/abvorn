# Abvorn VPS environment template.
# Copy to /opt/abvorn/abvorn/.env (or provide via setup.sh --env-file) and fill.
# Keep every value on ONE line. Quote values containing spaces.
#
# NOTE: GA4_CREDENTIALS_JSON must be a single-line JSON string. If your raw
# credential JSON is multi-line, join it to one line first.

# --- Model providers ------------------------------------------------
OPENAI_KEY=
DEEPSEEK_KEY=
GEMINI_KEY=
GROQ_KEY=
GLM_KEYS=

# --- Media / search / research --------------------------------------
PEXELS_KEY=
OPENWEB_NINJA_KEY=
TAVILY_KEY=
CEREBRAS_KEY=

# --- Affiliate --------------------------------------------------------
AMAZON_TAG=
SHAREASALE_ID=
EBAY_CAMPID=

# --- Email + mailing -------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
SHEET_ID=
APPS_SCRIPT_URL=
LISTMONK_URL=
LISTMONK_TOKEN=

# --- GA4 analytics ----------------------------------------------------
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=

# --- Notifications -----------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub (write access for pushing content cycles) -----------------
GITHUB_TOKEN=
GITHUB_REPO=Abvorn-Media/abvorn

# --- Site / social / automation ---------------------------------------
SITE_URL=https://abvorn.com
COMPOSIO_KEY=
KILL_SWITCH_PASSWORD=

# --- Evolution ---------------------------------------------------------
ABVORN_GENESIS_VERSION=1
# Optional: run_evolution.py loop interval in seconds
ABVORN_EVOLVE_INTERVAL=1800