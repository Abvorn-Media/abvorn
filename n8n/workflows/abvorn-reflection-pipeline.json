{
  "name": "Abvorn Reflection Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "abvorn-reflection",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "trigger",
      "name": "Reflection Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -320,
        0
      ],
      "webhookId": "abvorn-reflection"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ABVORN_URL }}/api/content/recent",
        "options": {}
      },
      "id": "get_content",
      "name": "Get Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ABVORN_URL }}/webhook/abvorn/gsc_fetch",        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ABVORN_WEBHOOK_TOKEN }}"
            }
          ]
        },

        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}"
      },
      "id": "gsc_fetch",
      "name": "Fetch GSC Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ABVORN_URL }}/webhook/abvorn/generate_reflection",        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ABVORN_WEBHOOK_TOKEN }}"
            }
          ]
        },

        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $('Get Content').item.json, performance: $json }) }}"
      },
      "id": "generate_reflection",
      "name": "Generate Reflection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ABVORN_URL }}/webhook/abvorn/journal_update",        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ABVORN_WEBHOOK_TOKEN }}"
            }
          ]
        },

        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reflection_id: $json.reflection_id }) }}"
      },
      "id": "journal_update",
      "name": "Update Evolution Journal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ]
    }
  ],
  "connections": {
    "Reflection Webhook": {
      "main": [
        [
          {
            "node": "Get Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Content": {
      "main": [
        [
          {
            "node": "Fetch GSC Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch GSC Data": {
      "main": [
        [
          {
            "node": "Generate Reflection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Reflection": {
      "main": [
        [
          {
            "node": "Update Evolution Journal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}