        "jsonBody": "={{ JSON.stringify({ carousel: $json.body.carousel, platform: $json.body.platform }) }}"
      },
      "id": "publish",
      "name": "Debate via Colosseum",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        0
      ]
    }
  ],
  "connections": {
    "Publish Webhook": {
      "main": [
        [
          {
            "node": "Debate via Colosseum",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
