    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d = $input.first().json;\nconst clicks = d.clicks ?? d.total_clicks ?? 0;\nconst impressions = d.impressions ?? d.total_impressions ?? 0;\nif (clicks === 0 && impressions === 0) {\n  throw new Error('GSC summary missing click data');\n}\nreturn [{\n  json: {\n    date: new Date().toISOString().slice(0, 10),\n    clicks: clicks,\n    impressions: impressions,\n    ctr: typeof d.avg_ctr === 'number' ? d.avg_ctr : (impressions > 0 ? clicks / impressions : 0),\n    avgPosition: d.avg_position ?? d.avgPosition ?? null,\n    property: d.property ?? null,\n    source: 'gsc',\n  },\n}];"
      },
