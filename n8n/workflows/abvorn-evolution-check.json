{
  "name": "Abvorn Evolution Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 14
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Biweekly Monday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.ABVORN_URL }}/webhook/abvorn/evolution_check",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "options": {}
      },
      "id": "evolution_check",
      "name": "Check Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.should_evolve }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "gate",
      "name": "Should Evolve?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, 0]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "evolve",
      "name": "Trigger Evolution",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [560, 0]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "skip",
      "name": "Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [560, 240]
    }
  ],
  "connections": {
    "Biweekly Monday": {
      "main": [
        [
          {
            "node": "Check Evolution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Evolution": {
      "main": [
        [
          {
            "node": "Should Evolve?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Evolve?": {
      "main": [
        [
          {
            "node": "Trigger Evolution",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
