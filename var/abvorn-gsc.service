[Unit]
Description=Trigger Abvorn GSC Analysis n8n workflow
After=network.target n8n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/usr/bin/curl -s -X POST -H "Content-Type: application/json" -d '{}' http://127.0.0.1:5678/webhook/abvorn-gsc-analysis
StandardOutput=journal
StandardError=journal
