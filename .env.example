# Abvorn Secrets — copy to ~/.abvorn/boardroom/secrets.json
# Or export as environment variables (env vars override JSON).
#
# Required:
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=youruser/yourrepo
SITE_URL=https://youruser.github.io/yourrepo
AMAZON_TAG=yourtag-20
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# Optional — social posting:
COMPOSIO_KEY=composio_xxx_xxxxxxxxxxxx

# Optional — analytics:
GA4_PROPERTY_ID=123456789
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_api_secret
# GA4_CREDENTIALS_JSON — full service-account JSON as a string, or save as ga4_credentials.json

# Optional — email:
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional — media:
PEXELS_KEY=xxxxxxxxxxxxxxxxxxxxxx

# Optional — LLM models (system works without these via OpenKilo free models):
OPENAI_KEY=sk-...
DEEPSEEK_KEY=sk-...
GEMINI_KEY=AIza...
GROQ_KEY=gsk_...
QWEN_KEY=sk-...
GLM_KEYS=["your-glm-key"]

# Optional — research:
OPENWEB_NINJA_KEY=
TAVILY_KEY=
CEREBRAS_KEY=
KIMI_KEY=

# Optional — Google Sheets (for GSC Analysis n8n workflow):
SHEET_ID=1bNNoYcFFIUe0ZCdj9iAwvFbvgTLc5fRcgD26mZLzmdM
